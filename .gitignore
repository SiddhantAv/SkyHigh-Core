# =============================================================================
# SkyHigh — production-oriented .gitignore
#
# INTENTIONALLY TRACKED (do not add patterns that exclude these):
#   PRD.md, README.md, PROJECT_STRUCTURE.md, WORKFLOW_DESIGN.md,
#   ARCHITECTURE.md, API-SPECIFICATION.md, CHAT_HISTORY.md, tests/
#   docker-compose.yml (root — canonical stack; not override files)
#   coverage.xml, .coverage*, htmlcov/ (coverage reports — commit for submissions)
# =============================================================================

# ----- Secrets & environment (never commit) -----
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.secret
secrets/
.secrets/
credentials.json
service-account*.json
.aws/credentials
.netrc

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
ENV/
env/
.envrc

# Type checkers / linters / formatters (local caches)
.mypy_cache/
.ruff_cache/
.pytype/
.dmypy.json
dmypy.json
.pyre/
.pytest_cache/
.hypothesis/
.tox/
.nox/
.cache
pytestdebug.log

# ----- Local databases & dumps (dev accidents) -----
*.sqlite
*.sqlite3
*.db
.pytest_sqlite.db
*.sql.gz
*.dump

# ----- Logs & runtime -----
*.log
logs/
*.pid
tmp/
temp/

# ----- OS -----
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ----- Editors & IDEs -----
.idea/
*.iml
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ----- Docker / Compose overrides (often contain secrets) -----
# Root docker-compose.yml is committed and must stay visible to Git.
!docker-compose.yml
docker-compose.override.yml
docker-compose.*.local.yml
*.override.yml

# ----- Packaging / misc -----
*.manifest
*.spec
node_modules/
